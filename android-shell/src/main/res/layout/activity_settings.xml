<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/surface"
    android:fillViewport="true"
    tools:context=".SettingsActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageButton
                android:id="@+id/buttonBackFromSettings"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/action_back_to_dashboard"
                android:padding="12dp"
                android:src="@android:drawable/ic_media_previous"
                android:tint="@color/on_surface" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/settings_screen_title"
                    android:textAppearance="@style/TextAppearance.Material3.DisplaySmall"
                    android:textColor="@color/on_surface" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/settings_screen_subtitle"
                    android:textColor="@color/on_surface_variant" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@drawable/panel_background"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/summary_heading"
                android:textAppearance="@style/TextAppearance.Material3.TitleMedium"
                android:textColor="@color/on_surface" />

            <TextView
                android:id="@+id/textSummaryBackend"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:textColor="@color/on_surface_variant"
                tools:text="Backend online: provider=rule-based" />

            <TextView
                android:id="@+id/textSummaryTermux"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:textColor="@color/on_surface_variant"
                tools:text="Termux ready" />

            <TextView
                android:id="@+id/textSummaryRoot"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:textColor="@color/on_surface_variant"
                tools:text="Root unavailable" />

            <TextView
                android:id="@+id/textSummaryAccessibility"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:textColor="@color/on_surface_variant"
                tools:text="Accessibility service enabled" />

            <TextView
                android:id="@+id/textSummaryMicrophone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:textColor="@color/on_surface_variant"
                tools:text="Microphone granted" />

            <TextView
                android:id="@+id/textSummaryNotifications"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:textColor="@color/on_surface_variant"
                tools:text="Notifications granted" />

            <TextView
                android:id="@+id/textSummaryService"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:textColor="@color/on_surface_variant"
                tools:text="Shell service enabled" />

            <TextView
                android:id="@+id/textSummaryModel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:textColor="@color/on_surface_variant"
                tools:text="Active model profile: rule-based" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@drawable/panel_background"
            android:orientation="vertical"
            android:padding="16dp">

            <EditText
                android:id="@+id/inputBackendUrl"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/hint_backend_url"
                android:inputType="textUri"
                android:textColor="@color/on_surface"
                android:textColorHint="@color/on_surface_variant" />

            <EditText
                android:id="@+id/inputWakePhrase"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:hint="@string/hint_wake_phrase"
                android:inputType="textCapWords"
                android:textColor="@color/on_surface"
                android:textColorHint="@color/on_surface_variant" />

            <Button
                android:id="@+id/buttonSaveSettings"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/action_save_settings" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@drawable/panel_background"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/ai_models_heading"
                android:textAppearance="@style/TextAppearance.Material3.TitleMedium"
                android:textColor="@color/on_surface" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/ai_models_subtitle"
                android:textColor="@color/on_surface_variant" />

            <RadioGroup
                android:id="@+id/radioProviderGroup"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp">

                <RadioButton
                    android:id="@+id/radioProviderRuleBased"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/ai_mode_rule_based" />

                <RadioButton
                    android:id="@+id/radioProviderCloud"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/ai_mode_cloud" />

                <RadioButton
                    android:id="@+id/radioProviderLocal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/ai_mode_local" />
            </RadioGroup>

            <LinearLayout
                android:id="@+id/cloudProfileFields"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="vertical"
                android:visibility="gone">

                <EditText
                    android:id="@+id/inputCloudBaseUrl"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="@string/hint_cloud_base_url"
                    android:inputType="textUri"
                    android:textColor="@color/on_surface"
                    android:textColorHint="@color/on_surface_variant" />

                <EditText
                    android:id="@+id/inputCloudApiKey"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:hint="@string/hint_cloud_api_key"
                    android:inputType="textPassword"
                    android:textColor="@color/on_surface"
                    android:textColorHint="@color/on_surface_variant" />

                <EditText
                    android:id="@+id/inputCloudModel"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:hint="@string/hint_cloud_model"
                    android:inputType="text"
                    android:textColor="@color/on_surface"
                    android:textColorHint="@color/on_surface_variant" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/localProfileFields"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="vertical"
                android:visibility="gone">

                <EditText
                    android:id="@+id/inputLocalBaseUrl"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="@string/hint_local_base_url"
                    android:inputType="textUri"
                    android:textColor="@color/on_surface"
                    android:textColorHint="@color/on_surface_variant" />

                <EditText
                    android:id="@+id/inputLocalApiKey"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:hint="@string/hint_local_api_key"
                    android:inputType="textPassword"
                    android:textColor="@color/on_surface"
                    android:textColorHint="@color/on_surface_variant" />

                <EditText
                    android:id="@+id/inputLocalModel"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:hint="@string/hint_local_model"
                    android:inputType="text"
                    android:textColor="@color/on_surface"
                    android:textColorHint="@color/on_surface_variant" />
            </LinearLayout>

            <Button
                android:id="@+id/buttonApplyAiSettings"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/action_apply_ai_settings" />

            <TextView
                android:id="@+id/textAiConfigStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:textColor="@color/on_surface_variant"
                tools:text="Apply AI provider settings" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@drawable/panel_background"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/setup_heading"
                android:textAppearance="@style/TextAppearance.Material3.TitleMedium"
                android:textColor="@color/on_surface" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/setup_subtitle"
                android:textColor="@color/on_surface_variant" />

            <TextView
                android:id="@+id/textAccessibilityStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:textColor="@color/on_surface_variant"
                tools:text="Accessibility disabled" />

            <Button
                android:id="@+id/buttonReviewPermissions"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/action_review_permissions" />

            <Button
                android:id="@+id/buttonAccessibilitySettings"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/action_open_accessibility_settings" />

            <Button
                android:id="@+id/buttonNotificationSettings"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/action_open_notification_settings" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@drawable/panel_background"
            android:orientation="vertical"
            android:padding="16dp">

            <Switch
                android:id="@+id/switchService"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/label_service" />

            <Switch
                android:id="@+id/switchWake"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/label_wake_phrase" />

            <Switch
                android:id="@+id/switchAutoStart"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/label_autostart_backend" />

            <Switch
                android:id="@+id/switchOverlay"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/label_overlay" />

            <Switch
                android:id="@+id/switchAdvanced"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/label_advanced_mode" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>